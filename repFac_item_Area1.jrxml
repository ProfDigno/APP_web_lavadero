<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repFac_item_Area1" language="groovy" pageWidth="553" pageHeight="114" columnWidth="553" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="pidfactura" class="java.lang.String"/>
	<queryString>
		<![CDATA[select fk_idfactura as idfactura,cantidad as cant,nombre as descrip,precio_unitario as punitario, 
(0) as exenta,(0) as iva5,(cantidad*precio_unitario) as iva10
from factura_item where fk_idfactura=$P{pidfactura};]]>
	</queryString>
	<field name="idfactura" class="java.lang.String"/>
	<field name="cant" class="java.math.BigDecimal"/>
	<field name="descrip" class="java.lang.String"/>
	<field name="punitario" class="java.math.BigDecimal"/>
	<field name="exenta" class="java.lang.Integer"/>
	<field name="iva5" class="java.lang.Integer"/>
	<field name="iva10" class="java.math.BigDecimal"/>
